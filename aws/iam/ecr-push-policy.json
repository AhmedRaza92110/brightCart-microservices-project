{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ECRAuthentication",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PushBrightCartImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:CompleteLayerUpload",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": [
        "acc:repository/brightcart-frontend",
        "acc:repository/brightcart-auth-service",
        "acc:repository/brightcart-profile-service",
        "acc:repository/brightcart-product-service",
        "acc:repository/brightcart-order-service",
        "acc:repository/brightcart-payment-service",
        "acc:repository/brightcart-message-service",
        "acc:repository/brightcart-history-service"
      ]
    }
  ]
}
